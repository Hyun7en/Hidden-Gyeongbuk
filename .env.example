# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hidden_gyeongbuk
DB_USERNAME=app
DB_PASSWORD=app
DB_ROOT_PASSWORD=root

# Spring Boot
SERVER_PORT=8080

# TourAPI (공공데이터포털 - KorService2/EngService2)
# https://www.data.go.kr 에서 "국문 관광정보 서비스_GW" 신청 후 디코딩 키를 넣을 것
TOURAPI_SERVICE_KEY=

# Google Cloud Translation API (장소 제목/설명 번역 전용)
# https://console.cloud.google.com 에서 프로젝트 생성 > Cloud Translation API 활성화 > API 키 발급
TRANSLATE_API_KEY=

# Gemini (영문 제목 localization 전용 — ADR-026. 백엔드 전용/프론트에 노출 금지)
GEMINI_API_KEY=

# --- 프론트 빌드 시점에 번들로 구워지는 값 (VITE_*) ---
# 개발은 frontend/.env를 Vite가 읽지만, docker compose는 frontend/.env를 보지 않고
# 이 루트 .env만 읽는다(docker-compose.yml의 build.args). 배포에서 비어 있으면
# 빈 키가 번들에 박혀 지도가 죽는다 — 로컬에서는 끝까지 드러나지 않는 종류의 고장이다.
# 값을 바꾸면 재시작이 아니라 이미지 재빌드가 필요하다.
# (다른 VITE_* 는 Dockerfile이 ARG로 받지 않으므로 여기 적어도 전달되지 않는다.
#  새로 추가하려면 docker-compose.yml의 build.args와 Dockerfile의 ARG/ENV를 같이 늘릴 것.)
VITE_KAKAO_MAP_KEY=
