# Kakao Maps JS SDK
# https://developers.kakao.com 앱 설정 > 앱 키 > JavaScript 키
# 사용하는 도메인(localhost:5173, 배포 도메인)을 플랫폼 > Web에 등록해야 동작함
VITE_KAKAO_MAP_KEY=

# 백엔드 API 베이스 URL — 로컬 개발은 비워둘 것(Vite 프록시가 /api를 백엔드로 전달).
# 배포에서 백엔드가 프론트와 다른 도메인일 때만 지정한다.
# VITE_API_BASE_URL=

# 문의 화면(S8)에 노출할 이메일. 비우면 Contact.tsx의 기본값을 쓴다.
# 이 파일은 Vite dev/로컬 빌드만 읽는다 — Docker 배포는 ARG로 받는 값만 번들에 들어가고
# 이 키는 ARG에 없으므로 배포본은 항상 코드 기본값이다. 바꾸려면 Dockerfile도 같이 고칠 것.
# VITE_CONTACT_EMAIL=
